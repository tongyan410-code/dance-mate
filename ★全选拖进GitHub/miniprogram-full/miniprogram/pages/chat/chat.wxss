.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}
.chat-notice { margin: 16rpx 24rpx 0; font-size: 26rpx; }

.chat {
  flex: 1;
  padding: 24rpx;
  min-height: 0;
}
.msg-row { display: flex; margin-bottom: 24rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-row.assistant { justify-content: flex-start; }
.bubble {
  max-width: 82%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.msg-row.assistant .bubble { background: #FFFFFF; color: var(--text); }
.msg-row.user .bubble { background: #2B6CB0; color: #FFFFFF; }
.typing { color: var(--text-sub); }

.quick { padding: 0 24rpx 16rpx; }
.quick-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.quick-chip {
  background: #FFFFFF;
  border: 2rpx solid #CFDCE8;
  color: #2B6CB0;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}

.input-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid var(--border);
}
.input {
  flex: 1;
  min-height: 88rpx;
  background: #F4F6F8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}
.send-btn {
  min-width: 140rpx;
  min-height: 88rpx;
  background: #2B6CB0;
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.send-btn::after { border: none; }
.send-btn:disabled { background: #B0BEC5; }

.clear-wrap { text-align: center; padding: 12rpx 0 24rpx; background: #FFFFFF; }
.clear { color: #90A4AE; font-size: 26rpx; }
