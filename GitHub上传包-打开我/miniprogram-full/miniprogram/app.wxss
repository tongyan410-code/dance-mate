/* 适老化全局样式：大字号、高对比、大按钮 */
page {
  --primary: #2B6CB0;
  --primary-dark: #1F4F86;
  --accent: #E07B39;
  --text: #263238;
  --text-sub: #607D8B;
  --bg: #F4F6F8;
  --card: #FFFFFF;
  --border: #E1E7EC;
  --success: #2E7D54;
  --danger: #C0392B;
  --radius: 16rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  color: var(--text);
  background: var(--bg);
  line-height: 1.6;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(20, 40, 60, 0.05);
}

.title-lg { font-size: 44rpx; font-weight: 700; }
.title-md { font-size: 36rpx; font-weight: 600; }
.text-sub { color: var(--text-sub); font-size: 28rpx; }
.text-primary { color: var(--primary); }
.text-danger { color: var(--danger); }
.text-success { color: var(--success); }

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  border-radius: 14rpx;
  font-size: 34rpx;
  font-weight: 600;
  background: var(--primary);
  color: #FFFFFF;
  border: none;
  padding: 0 32rpx;
}
.btn::after { border: none; }
.btn:active { opacity: 0.85; }
.btn-outline {
  background: #FFFFFF;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}
.btn-accent { background: var(--accent); }
.btn:disabled { background: #B0BEC5; color: #FFFFFF; }

.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.gap { gap: 16rpx; }

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--text-sub);
}
.empty-icon { font-size: 96rpx; line-height: 1; }

.notice {
  background: #FFF8E1;
  border-left: 8rpx solid #F0A500;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #6D4C00;
  margin-bottom: 24rpx;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
