.hero {
  background: linear-gradient(135deg, #2B6CB0, #1F4F86);
  color: #FFFFFF;
}
.hero .text-sub { color: #D6E6F5; }
.hero-sub { margin-top: 8rpx; }
.hello { margin-top: 20rpx; font-size: 30rpx; }

.status {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.status.ok { background: #E6F4EA; color: #2E7D54; }
.status.bad { background: #FDECEA; color: #C0392B; }

.server-url { margin-top: 6rpx; word-break: break-all; }
.tip { margin-top: 16rpx; }

.section-title { margin: 8rpx 0 20rpx; }

.grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.entry {
  width: calc(50% - 10rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(20,40,60,0.05);
}
.entry-icon { font-size: 56rpx; line-height: 1.2; }
.entry-title { font-size: 34rpx; font-weight: 600; margin-top: 12rpx; }
.entry-desc { font-size: 26rpx; color: #607D8B; margin-top: 4rpx; }

.footer-note .text-sub { display: block; margin-bottom: 8rpx; }
